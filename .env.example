# Compose interpolation; application credentials here are local development defaults.
PYTASK_IMAGE=pytask:local
PYTASK_HTTP_PORT=8000
PYTASK_POSTGRES_PORT=15432
POSTGRES_DB=pytask
POSTGRES_USER=pytask
POSTGRES_PASSWORD=pytask
PYTASK_CONTAINER_DATABASE_URL=postgresql+psycopg://pytask:pytask@postgres:5432/pytask
PYTASK_REGISTRY=pytask_service.example_tasks:registry
PYTASK_LOG_LEVEL=INFO
PYTASK_API_CONCURRENCY=100
PYTASK_API_GRACEFUL_SECONDS=30
PYTASK_API_DB_POOL_SIZE=5
PYTASK_API_DB_MAX_OVERFLOW=5
PYTASK_API_STOP_GRACE=45s
PYTASK_WORKER_POLL_SECONDS=0.5
PYTASK_WORKER_LEASE_SECONDS=30
PYTASK_WORKER_HEARTBEAT_SECONDS=10
PYTASK_WORKER_STOP_GRACE=330s
PYTASK_SCHEDULER_BATCH_SIZE=100
PYTASK_SCHEDULER_POLL_SECONDS=1
PYTASK_SCHEDULER_STOP_GRACE=15s
PYTASK_API_MEMORY=512m
PYTASK_WORKER_MEMORY=512m
PYTASK_SCHEDULER_MEMORY=256m
